# ========================================
# MatchCast AI — Environment Configuration
# ========================================
# Copy this file to .env and fill in real values.

# --- Genblaze / GMI Cloud ---
GENBLAZE_API_KEY=your-genblaze-api-key-here
GMI_CLOUD_API_KEY=your-gmi-cloud-api-key-here

# --- Backblaze B2 ---
B2_APPLICATION_KEY_ID=your-b2-key-id-here
B2_APPLICATION_KEY=your-b2-application-key-here
B2_BUCKET_NAME=matchcast-assets

# --- App Config ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Model Paths ---
YOLO_MODEL_PATH=data/models/best.pt
# Fallback to pretrained if fine-tuned model not available
YOLO_FALLBACK_MODEL=yolov8n.pt

# --- Processing ---
# Max video duration in seconds (for dev/demo)
MAX_VIDEO_DURATION=600
# Legacy setting (kept for compatibility)
FRAME_SAMPLE_RATE=2
# Analyze 1 of every N frames. Raise for faster CPU runs (e.g. 12-20).
PROCESSING_FRAME_STRIDE=12
# Optional cap on processed frames (empty = full video)
PROCESSING_FRAME_LIMIT=

# --- Static full-field camera mode ---
# true for fixed camera where the whole field remains visible.
STATIC_CAMERA_MODE=false
# Optional 4 source points in frame pixels (TL,TR,BR,BL):
# STATIC_CAMERA_SRC_POINTS=100,80;1820,80;1860,980;80,980
STATIC_CAMERA_SRC_POINTS=

# --- Optional jersey-number OCR ---
# Requires: pip install pytesseract and Tesseract OCR installed on system PATH.
JERSEY_OCR_ENABLED=false
# OCR sampling interval in analyzed frames.
JERSEY_OCR_INTERVAL=12
