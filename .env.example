# ========================================
# MatchCast AI — Environment Configuration
# ========================================
# Copy this file to .env and fill in real values.

# --- Genblaze / GMI Cloud ---
GENBLAZE_API_KEY=your-genblaze-key-here
GMI_CLOUD_API_KEY=your-gmi-cloud-key-here

# --- Backblaze B2 ---
B2_APPLICATION_KEY_ID=your-b2-key-id-here
B2_APPLICATION_KEY=your-b2-application-key-here
B2_BUCKET_NAME=matchcast-assets

# --- App Config ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Model Paths ---
YOLO_MODEL_PATH=data/models/best.pt
# Fallback to pretrained if fine-tuned model not available
YOLO_FALLBACK_MODEL=yolov8n.pt

# --- Processing ---
# Max video duration in seconds (for dev/demo)
MAX_VIDEO_DURATION=600
# Frame sampling rate for tracking (process every Nth frame)
FRAME_SAMPLE_RATE=2
# Analyze 1 of every N frames (high = faster, low = more accurate)
PROCESSING_FRAME_STRIDE=12
# Optional cap on frames processed (empty = whole video)
PROCESSING_FRAME_LIMIT=

# --- Static Camera Mode ---
STATIC_CAMERA_MODE=true
JERSEY_OCR_ENABLED=false
JERSEY_OCR_INTERVAL=12

# --- LLM Config ---
LLM_MODEL=gpt-4o-mini
GMI_TTS_MODEL=elevenlabs-tts-v3
GMI_TTS_VOICE=Rachel
